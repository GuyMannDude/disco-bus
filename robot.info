  "robot_info_version": "0.2",

  "name": "Disco-Bus",
  "tagline": "Push-based agent-to-agent message mesh. Tiny (~1000 LOC), push-not-poll, MCP-ready, optional Discord mirror.",
  "summary": "Disco-Bus is a lightweight message dispatcher that lets AI agents send and receive direct messages without polling. Each agent gets a persistent listener on a dedicated port; the dispatcher pushes envelopes on arrival and wakes the listener immediately. Messages are stored in SQLite with a three-state machine (SENT → DELIVERED → FAILED). Optional Discord mirroring lets humans observe all traffic in a channel. Five MCP tools (ping, ping_history, ping_read, inbox, thread) give any MCP-capable agent full send/receive/inspect capability. ~1000 lines of Python + Node, no message broker required.",
  "backstory": "Before Disco-Bus, Guy was the message bus. He'd copy Opie's output, paste it into CC's terminal, then copy CC's reply back to Opie. From his phone, this was impossible. Disco-Bus was built so agents could send structured messages to each other with full payloads, tracked delivery, and threaded replies — all stored in SQLite and mirrored to Discord so Guy could see every message from his phone. The name: Discord + Bus. The pitch: run your AI assembly line from your couch.",
  "version": "0.7.1",
  "license": "MIT",
  "homepage": "https://projectsparks.ai/disco-bus",
  "source": "https://github.com/GuyMannDude/disco-bus",
  "contact": "guy@projectsparks.ai",
  "maintainer": "Project Sparks",

  "capabilities": [
    "Push-based delivery — dispatcher pushes to a per-agent listener port immediately on receipt. No agent polling required.",
    "Persistent envelope store — SQLite WAL, concurrent reads don't block delivery writes.",
    "Three-state delivery machine — SENT → DELIVERED → FAILED. State queryable via REST or MCP.",
    "Inbox API — GET /mesh/inbox/<agent>?unread_only=true. Unread = no reply from recipient (derived, no schema change).",
    "Thread walk — GET /mesh/thread/<id> walks reply_to back to root via recursive CTE, returns full conversation in order.",
    "Body size enforcement — DISCOBUS_MAX_BODY_BYTES env (default 1 MiB) rejects oversized payloads at the boundary.",
    "Discord mirror — every envelope optionally mirrored to a Discord channel. Fire-and-forget, never blocks delivery.",
    "Auto-reply loop guard — agents with auto-reply enabled skip reply if inbound envelope already has reply_to set.",
    "Atomic inbox writes — temp-rename pattern so a crashing listener never leaves a corrupt envelope.",
    "Idempotent install — robot-install.sh and install.sh are both safe to re-run.",
    "Human-readable tracking IDs — msg-{id}-{YYYYMMDDTHHMMSS} visible in ls output."
  ],

  "exposes": {
    "rest_api": {
      "default_port": 9100,
      "base_path": "/mesh",
      "endpoints": [
        {"path": "/healthz", "method": "GET", "purpose": "Liveness probe."},
        {"path": "/mesh/ping", "method": "POST", "purpose": "Send a message envelope. Returns state=SENT + id on acceptance."},
        {"path": "/mesh/state/<id>", "method": "GET", "purpose": "Query delivery state for a message by id."},
        {"path": "/mesh/history", "method": "GET", "purpose": "Recent envelope history, newest first. ?limit= supported."},
        {"path": "/mesh/inbox/<agent>", "method": "GET", "purpose": "All messages addressed to agent. ?unread_only=true filters to messages with no reply from recipient."},
        {"path": "/mesh/thread/<id>", "method": "GET", "purpose": "Full conversation thread rooted at any message id in the chain. Returns {root_id, messages:[...]} in order."}
      ]
    },
    "mcp_tools": [
      {"name": "ping", "purpose": "Send a message to another agent. Identity bound server-side via DISCOBUS_AGENT env — caller cannot spoof from field."},
      {"name": "ping_history", "purpose": "Retrieve recent envelope history. ?limit controls depth."},
      {"name": "ping_read", "purpose": "Fetch a single envelope by id including full body."},
      {"name": "inbox", "purpose": "Read messages addressed to the calling agent. Defaults to DISCOBUS_AGENT. Optional unread_only filter."},
      {"name": "thread", "purpose": "Walk and return a full conversation thread from any message id in the chain."}
    ],
    "cli": [
      {"command": "python3 dispatcher/dispatcher.py", "purpose": "Start the dispatcher."},
      {"command": "python3 listeners/listener.py", "purpose": "Start a per-agent listener (DISCOBUS_AGENT + DISCOBUS_PORT from env)."},
      {"command": "node mcp/server.js", "purpose": "Start the MCP server for agent tool access."},
      {"command": "./install.sh", "purpose": "Interactive setup wizard — agent names, ports, Discord, systemd units, smoke test."},
      {"command": "./robot-install.sh [manifest]", "purpose": "Non-interactive install driven by robot.install manifest. JSON result on stdout."},
      {"command": "./setup-discord.sh", "purpose": "Step-by-step Discord bot creation and channel configuration."},
      {"command": "./uninstall.sh", "purpose": "Clean removal with confirmation before deleting data."}
    ]
  },

