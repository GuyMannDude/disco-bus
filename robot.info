  "robot_info_version": "0.1",

  "name": "Disco-Bus",
  "tagline": "Push-based agent-to-agent message mesh. Tiny (~1000 LOC), push-not-poll, MCP-ready, optional Discord mirror.",
  "summary": "Disco-Bus is a lightweight message dispatcher that lets AI agents send and receive direct messages without polling. Each agent gets a persistent listener on a dedicated port; the dispatcher pushes envelopes on arrival and wakes the listener immediately. Messages are stored in SQLite with a three-state machine (SENT → DELIVERED → FAILED). Optional Discord mirroring lets humans observe all traffic in a channel. Five MCP tools (ping, ping_history, ping_read, inbox, thread) give any MCP-capable agent full send/receive/inspect capability. ~1000 lines of Python + Node, no message broker required.",
  "version": "0.6.0",
  "license": "MIT",
  "homepage": "https://projectsparks.ai/disco-bus",
  "source": "https://github.com/GuyMannDude/disco-bus",
  "contact": "guy@projectsparks.ai",
  "maintainer": "Project Sparks",

  "capabilities": [
    "Push-based delivery — dispatcher pushes to a per-agent listener port immediately on receipt. No agent polling required.",
    "Persistent envelope store — SQLite WAL, concurrent reads don't block delivery writes.",
    "Three-state delivery machine — SENT → DELIVERED → FAILED. State queryable via REST or MCP.",
    "Inbox API — GET /mesh/inbox/<agent>?unread_only=true. Unread = no reply from recipient (derived, no schema change).",
    "Thread walk — GET /mesh/thread/<id> walks reply_to back to root via recursive CTE, returns full conversation in order.",
    "Body size enforcement — DISCOBUS_MAX_BODY_BYTES env (default 1 MiB) rejects oversized payloads at the boundary.",
    "Discord mirror — every envelope optionally mirrored to a Discord channel. Fire-and-forget, never blocks delivery.",
    "Auto-reply loop guard — agents with auto-reply enabled skip reply if inbound envelope already has reply_to set.",
    "Atomic inbox writes — temp-rename pattern so a crashing listener never leaves a corrupt envelope.",
    "Idempotent install — robot-install.sh and install.sh are both safe to re-run.",
    "Human-readable tracking IDs — msg-{id}-{YYYYMMDDTHHMMSS} visible in ls output."
  ],

