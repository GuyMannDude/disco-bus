# Pocket Bus settings — copy to ~/.config/pocket-bus/env and chmod 600.
# The systemd unit reads this file (EnvironmentFile=); the service refuses to
# start (exit 78) while either REQUIRED value is missing.
#
# Placeholders only: the real values never go in the repo.

# REQUIRED — the dispatcher's address, exactly as the bus bridges use it
# (their DISCOBUS_DISPATCHER), not the code's 127.0.0.1 default.
POCKET_DISCOBUS_URL=http://<dispatcher-host>:9100

# REQUIRED — the one Tailscale login allowed in. Defense-in-depth only: the
# per-device token is the gate (see README "What the login check does").
POCKET_TAILSCALE_LOGIN=<owner-login@example.com>

# Optional (defaults shown)
#POCKET_AGENT=Guy
#POCKET_DOOR_AGENT=CC
#POCKET_HOST_LABEL=the bus host
#POCKET_PORT=9101
#POCKET_CONFIG_DIR=~/.config/pocket-bus
#POCKET_STATE_DIR=~/.local/state/pocket-bus
#POCKET_WAKE_POLICY=<repo>/wake/wake-policy.json
